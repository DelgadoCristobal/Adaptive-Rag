# -----------------------------------------------------------------------------
# LLM Provider Options: "ollama", "openai", "local", "mock"
# -----------------------------------------------------------------------------

# 1. 100% FREE LOCAL OPTION (Ollama / LM Studio / LocalAI)
LLM_PROVIDER=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
OPENAI_API_KEY=ollama

# 2. OPTIONAL PAID OPTION (OpenAI)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Embeddings & Re-ranker (Local HuggingFace - 100% Free)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage Paths
DATA_RAW_DIR=data/raw
DATA_VAULT_DIR=data/vault
KUZU_DB_PATH=db_kuzu
CHROMA_DB_PATH=db_chroma

# Retrieval Hyperparameters
VECTOR_TOP_K=5
GRAPH_HOPS=2
RERANK_TOP_K=3
FUZZY_DEDUP_THRESHOLD=0.7
